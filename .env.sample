# --- MySkoda account -------------------------------------------------------
SKODA_USERNAME=some-email@gmail.com
SKODA_PASSWORD='a more complex password'
# Leave blank if the account has exactly one vehicle; set explicitly if
# you have more than one car on the account.
SKODA_VIN=TMBXXXXXXXXXXXX, TMBXXXXXXXXXXXX
# Only needed for Lock/Unlock control — leave blank to run read-only for that device.
SKODA_SPIN=****
VEHICLES_CSV_PATH=/app/config/vehicles.csv
DEVICES_JSON_PATH=/app/state/devices.json

# --- Domoticz ----------------------------------------------------------
DOMOTICZ_URL=http://192.168.0.1:8442
DOMOTICZ_USER=<userid_in_domoticz_with_admin_for_provisioning_and_user_for_daily_run>
DOMOTICZ_PASSWORD=<************>

# --- MQTT ----------------------------------------------------------------
MQTT_HOST=192.168.0.1
MQTT_PORT=1883
MQTT_USERNAME=<mqtt_username>
MQTT_PASSWORD=<mqtt_password>
MQTT_DOMOTICZ_OUT_TOPIC=myskoda/out

# --- Logging Settings --------------------------------------------------
LOG_LEVEL=debug
# --- Bridge behaviour --------------------------------------------------
POLL_INTERVAL_SECONDS=1800
ENABLE_GPS=true

DOMOTICZ_PROVISION=true

