# ============================================================
# Domoticz-MySkoda
# Example environment configuration
#
# Copy this file to .env and fill in your own values:
#
#   cp .env.example .env
#
# NEVER commit the real .env file to Git.
# ============================================================


# ------------------------------------------------------------
# MySkoda
# ------------------------------------------------------------

MYSKODA_USERNAME=
MYSKODA_PASSWORD=


# ------------------------------------------------------------
# Domoticz
# ------------------------------------------------------------

# Domoticz JSON API URL
DOMOTICZ_URL=http://192.168.1.100:8080

# Leave empty if Domoticz does not require authentication
DOMOTICZ_USERNAME=
DOMOTICZ_PASSWORD=


# ------------------------------------------------------------
# Domoticz provisioning
# ------------------------------------------------------------

# true  = automatically create/reuse Domoticz hardware and devices
# false = production/read-only mode; no provisioning API calls
DOMOTICZ_PROVISION=true


# ------------------------------------------------------------
# Vehicle position / GPS
# ------------------------------------------------------------

# true  = request vehicle position from MySkoda
# false = do not request vehicle position
ENABLE_GPS=true
